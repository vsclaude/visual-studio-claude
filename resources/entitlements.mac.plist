<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Notarization requires the hardened runtime, and under it V8 cannot
       JIT without these two. The daemon and the tsservers are this same
       binary under ELECTRON_RUN_AS_NODE, so they inherit them. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- A root's own `typescript` and node-pty's .node are loaded from outside
       what this team signed. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
